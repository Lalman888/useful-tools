# Every setting here is optional; the defaults shown are what the app uses.

# Where uploaded files and their metadata are stored.
DATA_DIR=./data

# Per-file ceiling in bytes. 0 means no limit, which is the default: uploads are
# chunked and streamed to disk, so the real bound is free space on the volume.
MAX_FILE_SIZE=0

# Size of each upload chunk, in bytes. Keep any reverse-proxy body limit above this.
CHUNK_SIZE=8388608

# Default lifetime for a new share link, in hours. 0 means links never expire.
DEFAULT_EXPIRY_HOURS=0

# How many files one request link will accept, and how long it lives by default
# (in hours; 0 means it never expires). A request link is handed to people
# outside your control, so these are the limits it leans on instead of secrecy.
MAX_REQUEST_FILES=25
DEFAULT_REQUEST_EXPIRY_HOURS=336

# Limits on spreadsheet previews.
MAX_PREVIEW_ROWS=50000
MAX_PARSE_BYTES=209715200

# Signs the cookie issued when someone unlocks a password-protected file or
# request link.
# Generated and stored in DATA_DIR/.secret if unset. Set it explicitly when
# running more than one instance, so their cookies are interchangeable.
# SHARE_SECRET=

# Chromium/Chrome binary used to render PDFs. Auto-detected when unset.
# CHROME_PATH=/usr/bin/chromium

# Where to look for a Chrome installed by `@puppeteer/browsers` rather than by
# the system. The newest build found there is used, so no version number needs
# writing down. Only needed on a host with no Chromium on its image.
# PUPPETEER_CACHE_DIR=/opt/render/project/src/.cache/puppeteer

# STUN servers used to negotiate direct transfers, comma separated.
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302

# Public origin, used for canonical and Open Graph tags. Needed at BUILD time,
# because those tags are baked into the statically rendered pages. Render and
# Vercel are detected automatically. robots.txt and sitemap.xml ignore this and
# use the requesting host instead.
# NEXT_PUBLIC_SITE_URL=https://tools.example.com

# Listen address.
PORT=3000
HOST=0.0.0.0
